# Store text files in the repository with LF line endings
* text=auto eol=lf

# Windows-native scripts may keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell/Python/config/source files should be LF
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ioc text eol=lf

# Binary artifacts
*.elf binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary