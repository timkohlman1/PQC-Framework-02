# Project-local wolfBoot configuration for NUCLEO-L4R5ZI-P / STM32L4R5.
#
# This file is copied to tools/wolfboot/.config by the framework
# build-wolfboot command. It is not a signing-key file and does not contain
# private key material.

TARGET=stm32l4
SIGN=ECC256
HASH=SHA256
VTOR=1
DEBUG?=0
NO_ASM?=0
SPMATH?=1
RAM_CODE?=0
NVM_FLASH_WRITEONCE=1
DUALBANK_SWAP?=0
ALLOW_DOWNGRADE?=0
WOLFBOOT_VERSION?=0
V?=0

# The wolfBoot STM32L4 HAL expects STM32CUBE to point at a tree containing
# Drivers/STM32L4xx_HAL_Driver, Drivers/CMSIS/Device/ST/STM32L4xx/Include,
# and Drivers/CMSIS/Include. From tools/wolfboot, the repository root is ../..
# and contains the CubeMX-generated Drivers tree.
STM32CUBE=../..

# Phase 10d planned STM32L4R5 secure-boot layout.
# IMAGE_HEADER_SIZE is decimal because wolfBoot shell tests compare it as an integer.
# Phase 11 uses one 8 KB header reserve across classical and planned PQC profiles.
# wolfBoot requires WOLFBOOT_SECTOR_SIZE to be larger than IMAGE_HEADER_SIZE,
# so the framework uses a 16 KB logical wolfBoot sector for the 8 KB header layout.
WOLFBOOT_SECTOR_SIZE=0x4000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x08020000
WOLFBOOT_PARTITION_SIZE=0x000E0000
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x08100000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x081E0000
IMAGE_HEADER_SIZE=8192

# Target-only ARM compile settings. Keep these in wolfBoot target CFLAGS rather
# than applying them to host keytools.
CFLAGS_EXTRA+=-mcpu=cortex-m4
CFLAGS_EXTRA+=-mthumb
# Upstream wolfBoot TARGET=stm32l4 currently defines STM32L4A6xx in arch.mk.
# Undefine it before selecting the project MCU, otherwise stm32l4xx.h
# tries to include stm32l4a6xx.h, which is not present in the CubeMX
# STM32L4R5 driver tree.
CFLAGS_EXTRA+=-USTM32L4A6xx
CFLAGS_EXTRA+=-DSTM32L4R5xx
CFLAGS_EXTRA+=-DUSE_HAL_DRIVER
# Do not add ../../Core/Inc here. wolfBoot also builds with
# WOLFSSL_USER_SETTINGS and must use tools/wolfboot/include/user_settings.h,
# not the STM32 application wolfSSL smoke-test settings in Core/Inc. The
# wolfBoot user_settings.h already provides its freestanding wolfCrypt
# configuration, including ctype, filesystem, threading, and hardening choices;
# duplicating those macros through CFLAGS_EXTRA breaks the build under -Werror.
CFLAGS_EXTRA+=-I../../Drivers/STM32L4xx_HAL_Driver/Inc
CFLAGS_EXTRA+=-I../../Drivers/CMSIS/Device/ST/STM32L4xx/Include
CFLAGS_EXTRA+=-I../../Drivers/CMSIS/Include

# STM32L4 flash_ex depends on PWR/PWREx helper symbols. The framework build
# profile temporarily patches wolfBoot's local hal/stm32l4xx_hal_conf.h so it
# includes stm32l4xx_hal_pwr.h and stm32l4xx_hal_pwr_ex.h in the normal HAL
# include order during the build, then restores the upstream file afterward.
#
# Upstream TARGET=stm32l4 only adds flash and flash_ex objects, so include the
# matching CubeMX PWR HAL objects in the project-local adaptation.
OBJS+=$(STM32CUBE)/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_pwr.o
OBJS+=$(STM32CUBE)/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_pwr_ex.o

# Phase 10k boot-timing instrumentation. The build helper temporarily patches
# wolfBoot's image verification path so wolfBoot measures DWT elapsed cycles
# around wolfBoot_verify_authenticity(), writes raw cycles, reported RCC clock values,
# and verification result code to a RAM2 mailbox, then restores the upstream
# source file after the build. The relocated HAL application reads that mailbox
# and emits parser-compatible UART lines after its UART is initialized.
CFLAGS_EXTRA+=-DWOLFBOOT_PQC_BOOT_TIMING=1
CFLAGS_EXTRA+=-DWOLFBOOT_PQC_BOOT_TIMING_MAILBOX_ADDR=0x10000000UL
