htmlcov/


# Phase 10g local application-signing by-products
# Private keys stay local. Signed images are generated artifacts.
secrets/wolfboot/
build/**/*_signed.bin
build/**/*_v*_signed.bin

# wolfBoot generated outputs from local source-tree builds
# Do not store private wolfBoot signing keys in Git.
tools/wolfboot/**/*.o
tools/wolfboot/**/*.a
tools/wolfboot/**/*.d
tools/wolfboot/**/*.map
tools/wolfboot/**/*.elf
tools/wolfboot/**/*.bin
tools/wolfboot/**/*.hex
tools/wolfboot/wolfboot.elf
tools/wolfboot/wolfboot.bin
tools/wolfboot/.config
tools/wolfboot/*.der
tools/wolfboot/*.pem
tools/wolfboot/*private*
tools/wolfboot/*signing_key*

# MQTT broker generated runtime state and local TLS material
experiment/mqtt-broker/runtime/
experiment/mqtt-broker/data/
experiment/mqtt-broker/log/
experiment/mqtt-broker/.env
.pqc-generated-state/

# Persistent wolfBoot signing tuples are local authoritative state
secrets/wolfboot/tuples/

# Canonical local cryptographic material
/secrets/


# Jupyter autosave artifacts
.ipynb_checkpoints/
